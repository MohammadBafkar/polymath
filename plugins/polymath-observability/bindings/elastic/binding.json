{
  "provider": "elastic",
  "capability": "observability",
  "transport": {
    "kind": "mcp",
    "server": "elastic"
  },
  "userConfigKeys": [
    "elasticEndpoint",
    "elasticApiKey"
  ],
  "title": "elastic",
  "description": "elastic as observability provider, supplied by polymath-observability.",
  "mcp": {
    "serverAliases": [
      "elastic",
      "elasticsearch"
    ],
    "packages": [
      "@elastic/mcp-server"
    ],
    "envKeys": [
      "ELASTIC_ENDPOINT",
      "ELASTIC_API_KEY"
    ]
  }
}
