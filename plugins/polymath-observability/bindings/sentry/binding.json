{
  "provider": "sentry",
  "capability": "observability",
  "transport": {
    "kind": "mcp",
    "server": "sentry"
  },
  "userConfigKeys": [
    "sentryToken",
    "sentryOrg"
  ],
  "title": "sentry",
  "description": "sentry as observability provider, supplied by polymath-observability.",
  "mcp": {
    "serverAliases": [
      "sentry"
    ],
    "packages": [
      "@sentry/mcp-server"
    ],
    "remoteUrls": [
      "https://mcp.sentry.dev/mcp"
    ],
    "envKeys": [
      "SENTRY_AUTH_TOKEN",
      "SENTRY_ORG"
    ]
  }
}
