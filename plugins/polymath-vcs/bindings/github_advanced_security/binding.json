{
  "provider": "github_advanced_security",
  "capability": "vulnerability_scanner",
  "transport": {
    "kind": "mcp",
    "server": "github"
  },
  "userConfigKeys": [
    "githubToken"
  ],
  "title": "github advanced security",
  "description": "github_advanced_security as vulnerability_scanner provider, supplied by polymath-vcs.",
  "mcp": {
    "serverAliases": [
      "github",
      "github-advanced-security"
    ],
    "packages": [
      "@modelcontextprotocol/server-github",
      "@github/mcp-server"
    ],
    "remoteUrls": [
      "https://api.githubcopilot.com/mcp"
    ],
    "envKeys": [
      "GITHUB_PERSONAL_ACCESS_TOKEN"
    ]
  }
}
