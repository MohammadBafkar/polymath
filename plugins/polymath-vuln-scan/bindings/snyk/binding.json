{
  "provider": "snyk",
  "capability": "vulnerability_scanner",
  "transport": {
    "kind": "mcp",
    "server": "snyk"
  },
  "userConfigKeys": [
    "snykToken",
    "snykOrg"
  ],
  "title": "snyk",
  "description": "snyk as vulnerability_scanner provider, supplied by polymath-vuln-scan.",
  "mcp": {
    "serverAliases": [
      "snyk"
    ],
    "packages": [
      "@snyk/mcp-server"
    ],
    "remoteUrls": [
      "https://mcp.snyk.io/mcp"
    ],
    "envKeys": [
      "SNYK_TOKEN",
      "SNYK_ORG"
    ]
  }
}
